# PostgreSQL connection string (Render/Railway provide this automatically)
DATABASE_URL=postgres://user:password@localhost:5432/scicomm

# Long, random secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of origins allowed to call this API, e.g.
# CORS_ORIGIN=https://yourdomain.com,https://your-app.onrender.com
CORS_ORIGIN=*

# Port the server listens on (Render sets this automatically)
PORT=4000

# Used only by `npm run seed` to set the initial admin password
SEED_ADMIN_PASSWORD=change-me-now
